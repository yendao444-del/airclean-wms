                okText={fundModalType === 'in' ? 'âœ… XÃ¡c nháº­n Thu' : 'âœ… XÃ¡c nháº­n Chi'}
                cancelText="Há»§y"
                okButtonProps={{
                    icon: <PlusOutlined />,
                    style: fundModalType === 'in'
                        ? { background: '#00ab56', borderColor: '#00ab56', fontWeight: 700 }
                        : { fontWeight: 700 },
                    danger: fundModalType === 'out',
                }}
                width={480}
            >
                {/* Banner nháº¯c loáº¡i giao dá»‹ch */}
                <div style={{
                    padding: '12px 16px', borderRadius: 8, marginBottom: 16,
                    background: fundModalType === 'in' ? '#f6ffed' : '#fff1f0',
                    border: `1px solid ${fundModalType === 'in' ? '#b7eb8f' : '#ffccc7'}`,
                    color: fundModalType === 'in' ? '#00ab56' : '#ff4d4f',
                    fontWeight: 600, fontSize: 13, textAlign: 'center',
                }}>
                    {fundModalType === 'in'
                        ? 'ðŸ“¥ Báº¡n Ä‘ang ghi nháº­n khoáº£n THU VÃ€O quá»¹'
                        : 'ðŸ“¤ Báº¡n Ä‘ang ghi nháº­n khoáº£n CHI RA tá»« quá»¹'}
                </div>
                <Form form={fundForm} layout="vertical">
                    <Form.Item name="note" label="Ná»™i dung" rules={[{ required: true, message: 'Nháº­p ná»™i dung giao dá»‹ch' }]}>
                        <Input size="large" placeholder={fundModalType === 'in' ? 'VD: ÄÃ³ng quá»¹ thÃ¡ng 3 (Team)' : 'VD: Mua nÆ°á»›c uá»‘ng cho team'} />
                    </Form.Item>
                    <Form.Item name="amount" label="Sá»‘ tiá»n (VNÄ)" rules={[{ required: true, message: 'Nháº­p sá»‘ tiá»n' }]}>
                        <InputNumber
                            style={{ width: '100%' }}
                            size="large"
                            min={1000}
                            step={10000}
                            formatter={v => `${v}`.replace(/\B(?=(\d{3})+(?!\d))/g, ',')}
                            parser={v => Number(v!.replace(/,/g, '')) as any}
