                    <p style={{ color: '#ff4d4f', fontSize: 13 }}>Sau khi chá»‘t, chá»‰ admin má»›i cÃ³ thá»ƒ sá»­a Ä‘á»•i dá»¯ liá»‡u ká»³ nÃ y.</p>
                </div>
            ),
            okText: 'Chá»‘t & KhÃ³a',
            cancelText: 'Há»§y',
            okType: 'primary',
            onOk: () => {
                const newLock: LockedPeriod = {
                    id: 'lock-' + Date.now(),
                    start: overviewDateRange[0].startOf('day').toISOString(),
                    end: overviewDateRange[1].endOf('day').toISOString(),
