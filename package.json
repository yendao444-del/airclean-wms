{
  "name": "quan-ly-ban-hang-desktop",
  "version": "1.0.193",
  "description": "Hệ thống quản lý bán hàng - Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npx prisma generate && npm run build && electron-builder"
  },
  "keywords": [
    "pos",
    "inventory",
    "sales"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@ant-design/icons": "^6.1.0",
    "@prisma/client": "5.22.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "adm-zip": "^0.5.16",
    "antd": "^6.2.3",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "electron-is-dev": "^3.0.1",
    "glob": "^13.0.1",
    "googleapis": "^171.4.0",
    "node-zklib": "^1.3.0",
    "prisma": "5.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "build": {
    "appId": "com.dby.pos",
    "productName": "DBY POS",
    "directories": {
      "output": "release4"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/@prisma/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/dotenv/**/*",
      "node_modules/xlsx/**/*",
      "node_modules/adm-zip/**/*",
      "node_modules/archiver/**/*",
      "node_modules/glob/**/*",
      "node_modules/googleapis/**/*",
      "node_modules/google-auth-library/**/*",
      "node_modules/gaxios/**/*",
      "node_modules/gtoken/**/*",
      "node_modules/bcryptjs/**/*",
      "!**/*.md",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.d.ts",
      "!**/CHANGELOG*",
      "!**/LICENSE*",
      "!**/readme*",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      ".env"
    ],
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "public/app_icon.ico"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  },
  "dependencies": {
    "winax": "^3.6.8"
  }
}
