{
  "name": "quan-ly-ban-hang-desktop",
  "version": "1.0.415",
  "description": "Hệ thống quản lý bán hàng - Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "embed:wms-token": "node scripts/embed-wms-token.js",
    "embed:google-oauth": "node scripts/prepare-google-oauth-config.js",
    "prepare:runtime-db": "node scripts/prepare-runtime-db-config.cjs",
    "prepare:r2-daily-evidence": "node scripts/prepare-r2-daily-evidence-config.js",
    "db:migrate:deploy": "prisma migrate deploy",
    "electron:dev": "node scripts/start-electron-dev.js",
    "electron:build": "npm run embed:wms-token && npm run embed:google-oauth && npm run prepare:r2-daily-evidence && npm run prepare:runtime-db && npx prisma generate && npm run build && electron-builder",
    "electron:installer": "npm run embed:wms-token && npm run embed:google-oauth && npm run prepare:r2-daily-evidence && npm run prepare:runtime-db && npx prisma generate && npm run build && electron-builder --win nsis --config.directories.output=release-installer"
  },
  "keywords": [
    "pos",
    "inventory",
    "sales"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@ant-design/icons": "^6.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "antd": "^6.2.3",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "nodemon": "^3.1.14",
    "prisma": "5.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "wait-on": "^9.0.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "build": {
    "appId": "com.dby.pos",
    "productName": "DBY POS",
    "directories": {
      "output": "release4"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "python/attendance_service.py",
      "python/requirements.txt",
      "python/dist/attendance_service.exe",
      "!electron/config.js",
      "!electron/supabase-storage.json",
      "!electron/**/*.env",
      "!electron/**/*.key",
      "!electron/**/*.pem",
      "!electron/gdrive-token.json",
      "!electron/gdrive-credentials.json",
      "node_modules/@prisma/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/@supabase/**/*",
      "node_modules/iceberg-js/**/*",
      "node_modules/tslib/**/*",
      "node_modules/dotenv/**/*",
      "node_modules/xlsx/**/*",
      "node_modules/adm-zip/**/*",
      "node_modules/archiver/**/*",
      "node_modules/glob/**/*",
      "node_modules/googleapis/**/*",
      "node_modules/google-auth-library/**/*",
      "node_modules/gaxios/**/*",
      "node_modules/gtoken/**/*",
      "node_modules/bcryptjs/**/*",
      "!**/*.md",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.d.ts",
      "!**/CHANGELOG*",
      "!**/LICENSE*",
      "!**/readme*",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma"
      },
      {
        "from": ".runtime-build/runtime.env",
        "to": "app/.env"
      }
    ],
    "win": {
      "target": "dir",
      "executableName": "DBY POS",
      "icon": "public/app_icon.ico"
    },
    "nsis": {
      "artifactName": "DBYPOS-v${version}-setup.${ext}",
      "installerIcon": "public/app_icon.ico",
      "uninstallerIcon": "public/app_icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DBY POS",
      "uninstallDisplayName": "DBY POS",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "asar": false,
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.110.8",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "glob": "^13.0.1",
    "googleapis": "^171.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "nodemailer": "^7.0.6",
    "pdfjs-dist": "^6.2.108",
    "uuid": "^11.1.0",
    "winax": "^3.6.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
