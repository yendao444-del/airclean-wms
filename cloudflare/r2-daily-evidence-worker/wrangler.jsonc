{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dby-pos-daily-evidence",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "DAILY_EVIDENCE_BUCKET",
      "bucket_name": "dby-pos-daily-evidence"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
